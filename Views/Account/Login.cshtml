@model LoginDemoCore.Models.LoginModel

<div class="login-box">
    <h2>Đăng nhập</h2>

    <form asp-controller="Account" asp-action="Login" method="post">
        <div class="form-group">
            <label asp-for="Username"></label>
            <input asp-for="Username" required />
        </div>
        <div class="form-group">
            <label asp-for="Password"></label>
            <input asp-for="Password" type="password" required />
        </div>
        <button type="submit">Login</button>
    </form>

    @if (ViewBag.Message != null)
    {
        string cssClass;
        if (ViewBag.Message == "Login success")
        {
            cssClass = "message-success";
        }
        else if (ViewBag.Message == "Login failed")
        {
            cssClass = "message-failed";
        }
        else
        {
            cssClass = "message-warning";
        }
        <p class="@cssClass">@ViewBag.Message</p>
    }
</div>
