@model LoginDemoCore.Models.Book

<div class="page-box">
    <h2>Thêm sách</h2>

    <form asp-controller="Book" asp-action="Create" method="post">
        <div class="form-group">
            <label asp-for="Name">Tên sách</label>
            <input asp-for="Name" />
            <span asp-validation-for="Name" class="field-error"></span>
        </div>
        <div class="form-group">
            <label asp-for="Price">Giá</label>
            <input asp-for="Price" />
            <span asp-validation-for="Price" class="field-error"></span>
        </div>
        <button type="submit">Thêm sách</button>
    </form>

    @if (ViewBag.Message != null)
    {
        <p class="message-success">@ViewBag.Message</p>
    }

    <p><a asp-controller="Book" asp-action="Index">Quay lại danh sách</a></p>
</div>
